        "        \"Attendance\": [attendance],\n",
        "        \"Previous_Score\": [previous_score]\n",
        "    })\n",
        "\n",
        "    prediction = model.predict(new_data)[0]\n",
        "    prediction = np.clip(prediction, 0, 100)\n",
        "\n",
        "    return round(float(prediction), 1)\n",
