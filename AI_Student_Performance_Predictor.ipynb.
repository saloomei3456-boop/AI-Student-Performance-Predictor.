        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Generate 200 fictional student records\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "study_hours = rng.uniform(0.5, 8, 200)\n",
        "attendance = rng.uniform(50, 100, 200)\n",
        "previous_score = rng.uniform(30, 95, 200)\n",
        "\n",
        "# Create fictional quiz scores with some randomness\n",
        "noise = rng.normal(0, 7, 200)\n",
        "\n",
        "quiz_scores = (\n",
        "    5 * study_hours\n",
        "    + 0.2 * attendance\n",
        "    + 0.35 * previous_score\n",
        "    + noise\n",
        ")\n",
        "\n",
        "quiz_scores = np.clip(quiz_scores, 0, 100)\n",
        "\n",
        "# Create the dataset\n",
        "data = pd.DataFrame({\n",
        "    \"Study_Hours\": study_hours,\n",
        "    \"Attendance\": attendance,\n",
        "    \"Previous_Score\": previous_score,\n",
        "    \"Quiz_Score\": quiz_scores\n",
        "})\n",
        "\n",
        "print(\"Total students:\", len(data))\n",
        "display(data.head())\n"
